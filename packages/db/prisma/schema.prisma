generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guild {
  id       String   @id
  name     String
  joinedAt DateTime @default(now())

  modules          GuildModule[]
  overrides        CommandOverride[]
  infractions      Infraction[]
  tasks            ScheduledTask[]
  menus            ReactionRoleMenu[]
  tickets          Ticket[]
  levels           LevelMember[]
  feeds            FeedCursor[]
  notes            ModNote[]
  audits           ModAudit[]
  staff            StaffMember[]
  messageFolders   MessageFolder[]
  messageTemplates MessageTemplate[]
  messageInteractions MessageInteraction[]
  loggedMessages      LoggedMessage[]
  serverLogEntries    ServerLogEntry[]

  /// The last case number handed out here. It only ever goes up, so a number
  /// that was purged is never given to a different case.
  caseCounter Int @default(0)
}

/// Per-guild module state. Settings are stored as JSON and validated against
/// the module's schema on read, so adding a setting needs no migration.
model GuildModule {
  guildId   String
  moduleId  String
  enabled   Boolean  @default(false)
  settings  String   @default("{}")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, moduleId])
}

/// Only written when an operator overrides the default, which is that every
/// command of an enabled module is visible.
model CommandOverride {
  guildId      String
  command      String
  enabled      Boolean  @default(true)
  allowRoles   String   @default("[]")
  denyChannels String   @default("[]")
  /// Discord permission bits a member needs to see the command, as a decimal
  /// string, or "everyone". Null keeps the command's own default.
  permissions  String?
  /// Null keeps whatever the command does by default.
  ephemeral    Boolean?
  /// The text an owner wrote before replies became full messages. Still read, and
  /// cleared the next time the reply is saved.
  response     String?
  /// A full message (text, embeds, buttons, reactions) as JSON, sent in place of
  /// the command's own reply, for commands that offer it.
  responseBody String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, command])
}

model Instance {
  id            Int       @id @default(1)
  ownerId       String?
  setupAt       DateTime?
  schemaVersion Int       @default(1)
  /// Whether the dashboard may ask GitHub for new releases and the roadmap. The owner can turn it off.
  updateChecks  Boolean   @default(true)
}

/// Auth.js's own tables, laid out the way @auth/prisma-adapter expects them.
/// This supersedes the previous hand-rolled Session model: Auth.js owns the
/// session lifecycle (creation, rotation, expiry sweeps) and the Account rows
/// are also where each user's Discord OAuth tokens live, which the dashboard
/// needs to call the Discord API on their behalf.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// A moderation action taken against a member. Rows are kept after the action
/// is reversed so a moderator can read a member's history, which is the point
/// of recording them separately from Discord's own audit log.
model Infraction {
  id          Int       @id @default(autoincrement())
  guildId     String
  userId      String
  moderatorId String
  action      String
  reason      String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  active      Boolean   @default(true)
  /// Stored rather than derived from row order, so removing a row for good
  /// leaves a gap and never renumbers the cases after it.
  caseNumber  Int       @default(0)
  /// Set when staff remove an entry from a member's record. The row stays, so
  /// the removal is visible in the mod dashboard; only the owner can purge it.
  voidedAt    DateTime?
  voidedBy    String?
  voidReason  String?
  /// Set when someone changes the reason after the action was taken.
  editedAt    DateTime?
  editedBy    String?
  /// Messages a moderator attached, copied as they read when the action was taken, as JSON.
  evidence    String    @default("[]")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, caseNumber])
  @@index([guildId, userId])
  @@index([guildId, createdAt])
}

/// Work the bot has to carry out later: lifting a temporary ban, closing an
/// idle ticket. This lives in the database, not a timer. A restart would lose
/// a timer, and a lost unban leaves someone banned with nothing to explain it.
model ScheduledTask {
  id      Int      @id @default(autoincrement())
  guildId String
  kind    String
  runAt   DateTime
  payload String   @default("{}")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([runAt])
}

/// A role menu the bot has posted. The message id is the only link between a
/// reaction Discord reports and the roles that menu hands out, so it has to
/// outlive the process that posted it.
model ReactionRoleMenu {
  id        Int    @id @default(autoincrement())
  guildId   String
  channelId String
  messageId String @unique
  mapping   String @default("[]")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

/// One support ticket, keyed by the channel opened for it.
model Ticket {
  id        Int       @id @default(autoincrement())
  guildId   String
  channelId String    @unique
  openerId  String
  subject   String?
  status    String    @default("open")
  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  closedBy  String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
}

/// Per-member experience. This is the only table written on a hot path, one
/// upsert per message that earns experience, so it stays narrow and is keyed
/// for exactly that write.
model LevelMember {
  guildId     String
  userId      String
  xp          Int      @default(0)
  level       Int      @default(0)
  lastAwardAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([guildId, xp])
}

/// Where the feeds module has got to with one source. Without the remembered
/// ids, every restart would post the whole feed again. The key is `rss:<url>`
/// or `steam:<appid>:<channel>`: a game shown in two channels is tracked
/// separately in each.
model FeedCursor {
  guildId   String
  sourceKey String
  seen      String    @default("[]")
  checkedAt DateTime?
  lastError String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, sourceKey])
}

/// A staff note about a member. Deleting one only hides it; the owner can
/// purge it for good, which removes its history along with it.
model ModNote {
  id        Int       @id @default(autoincrement())
  guildId   String
  userId    String
  authorId  String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
}

/// Everything staff do in the mod dashboard. `before` and `after` hold JSON
/// snapshots so an edit or a removal can be read back in full.
model ModAudit {
  id           Int      @id @default(autoincrement())
  guildId      String
  at           DateTime @default(now())
  actorId      String
  actorName    String
  actorRole    String
  kind         String
  targetUserId String?
  infractionId Int?
  noteId       Int?
  summary      String
  before       String?
  after        String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, at])
  @@index([guildId, targetUserId])
  @@index([infractionId])
  @@index([noteId])
}

/// Who may open the mod dashboard for a server, and at what level. The
/// instance owner is implied everywhere and never listed here.
model StaffMember {
  guildId String
  userId  String
  role    String
  addedBy String
  addedAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
}

/// A folder for message templates. One level deep: a folder holds templates,
/// never other folders, which is enough to keep a long list tidy.
model MessageFolder {
  id        Int      @id @default(autoincrement())
  guildId   String
  name      String
  createdAt DateTime @default(now())

  guild     Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  templates MessageTemplate[]

  @@index([guildId])
}

/// A message an owner built in the dashboard, kept so it can be sent again.
/// `embeds` is a JSON array in the shape packages/core/src/message.ts
/// validates, so a template that was valid when saved stays valid to send.
model MessageTemplate {
  id         Int       @id @default(autoincrement())
  guildId    String
  /// Null for a template that sits outside every folder. Deleting a folder
  /// leaves its templates here rather than taking them along.
  folderId   Int?
  name       String
  content    String    @default("")
  embeds     String    @default("[]")
  /// Link buttons, as JSON. Reactions are a JSON list of emoji.
  buttons    String    @default("[]")
  /// Select menus, as JSON.
  selects    String    @default("[]")
  reactions  String    @default("[]")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSentAt DateTime?

  guild  Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  folder MessageFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([guildId, folderId])
}

/// What the buttons and menus of a message that was sent do. Kept per message, so
/// editing a template afterwards never changes one that is already out.
model MessageInteraction {
  messageId String   @id
  guildId   String
  channelId String
  /// Buttons and menus as sent, with their actions, as JSON.
  buttons   String   @default("[]")
  selects   String   @default("[]")
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

/// A message the bot saw, kept so staff can search what was said, including what
/// was deleted or edited. Only written while a server has the message log on, and
/// pruned to the number of days that server chose. `content` is the current text;
/// earlier text is in LoggedMessageEdit.
model LoggedMessage {
  id          Int       @id @default(autoincrement())
  guildId     String
  messageId   String
  channelId   String
  /// The channel's name when the message was sent, so the log still reads if it is renamed or deleted.
  channelName String    @default("")
  authorId    String
  authorName  String    @default("")
  content     String    @default("")
  /// Names and links of attached files as JSON. The files themselves stay on Discord.
  attachments String    @default("[]")
  createdAt   DateTime
  editedAt    DateTime?
  deletedAt   DateTime?

  guild Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  edits LoggedMessageEdit[]

  @@unique([guildId, messageId])
  @@index([guildId, createdAt])
  @@index([guildId, authorId, createdAt])
  @@index([guildId, channelId, createdAt])
}

/// A version of a message's text that an edit replaced, and when that text went up.
model LoggedMessageEdit {
  id       Int      @id @default(autoincrement())
  loggedId Int
  content  String
  at       DateTime

  message LoggedMessage @relation(fields: [loggedId], references: [id], onDelete: Cascade)

  @@index([loggedId])
}

/// One thing that happened on the server, kept so staff can search it. Written only for the
/// kinds of event a server has switched on, and pruned to the number of days it chose. The
/// ids and names are copied in, so an entry still reads right after a member or channel is gone.
model ServerLogEntry {
  id          Int      @id @default(autoincrement())
  guildId     String
  at          DateTime @default(now())
  /// One of the categories in packages/core/src/serverlog.ts.
  category    String
  /// One of the types in packages/core/src/serverlog.ts.
  type        String
  actorId     String?
  actorName   String   @default("")
  targetId    String?
  targetName  String   @default("")
  channelId   String?
  channelName String   @default("")
  summary     String
  /// Changes, notes and the message it is about, as JSON.
  details     String   @default("{}")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, at])
  @@index([guildId, category, at])
  @@index([guildId, type, at])
  @@index([guildId, actorId, at])
  @@index([guildId, targetId, at])
  @@index([guildId, channelId, at])
}
