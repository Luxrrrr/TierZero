generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guild {
  id       String   @id
  name     String
  joinedAt DateTime @default(now())

  modules             GuildModule[]
  overrides           CommandOverride[]
  infractions         Infraction[]
  tasks               ScheduledTask[]
  menus               ReactionRoleMenu[]
  tickets             Ticket[]
  levels              LevelMember[]
  feeds               FeedCursor[]
  notes               ModNote[]
  audits              ModAudit[]
  staff               StaffMember[]
  messageFolders      MessageFolder[]
  messageTemplates    MessageTemplate[]
  messageInteractions MessageInteraction[]
  messageSends        MessageSend[]
  loggedMessages      LoggedMessage[]
  serverLogEntries    ServerLogEntry[]
  ticketPanelPosts    TicketPanelPost[]
  ticketCooldowns     TicketCooldown[]
  ticketAudits        TicketAudit[]
  appeals             Appeal[]
  lockedChannels      LockedChannel[]
  voiceRooms          VoiceRoom[]
  lfgPosts            LfgPost[]
  signupEvents        SignupEvent[]
  groupPanelPosts     GroupPanelPost[]
  playGroups          PlayGroup[]
  workflowValues      WorkflowValue[]

  /// The last case number handed out here. It only ever goes up, so a number
  /// that was purged is never given to a different case.
  caseCounter Int @default(0)
}

/// Per-guild module state. Settings are stored as JSON and validated against
/// the module's schema on read, so adding a setting needs no migration.
model GuildModule {
  guildId   String
  moduleId  String
  enabled   Boolean  @default(false)
  settings  String   @default("{}")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, moduleId])
}

/// Only written when an operator overrides the default, which is that every
/// command of an enabled module is visible.
model CommandOverride {
  guildId      String
  command      String
  enabled      Boolean  @default(true)
  allowRoles   String   @default("[]")
  denyChannels String   @default("[]")
  /// Discord permission bits a member needs to see the command, as a decimal
  /// string, or "everyone". Null keeps the command's own default.
  permissions  String?
  /// Null keeps whatever the command does by default.
  ephemeral    Boolean?
  /// The text an owner wrote before replies became full messages. Still read, and
  /// cleared the next time the reply is saved.
  response     String?
  /// A full message (text, embeds, buttons, reactions) as JSON, sent in place of
  /// the command's own reply, for commands that offer it.
  responseBody String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, command])
}

model Instance {
  id            Int       @id @default(1)
  ownerId       String?
  setupAt       DateTime?
  schemaVersion Int       @default(1)
  /// Whether the dashboard may ask GitHub for new releases and the roadmap. The owner can turn it off.
  updateChecks  Boolean   @default(true)
  /// The address the dashboard is opened at, learned from the owner's own requests. The bot puts it in links to cases.
  dashboardUrl  String?
  /// How the bot shows in the member list: online, idle, dnd or invisible. Its name and picture are held by Discord, not here.
  botStatus       String   @default("online")
  /// What the bot says it is doing: none, playing, watching, listening, competing or custom.
  botActivityType String   @default("none")
  botActivityText String   @default("")
}

/// Auth.js's own tables, laid out the way @auth/prisma-adapter expects them.
/// This supersedes the previous hand-rolled Session model: Auth.js owns the
/// session lifecycle (creation, rotation, expiry sweeps) and the Account rows
/// are also where each user's Discord OAuth tokens live, which the dashboard
/// needs to call the Discord API on their behalf.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// A moderation action taken against a member. Rows are kept after the action
/// is reversed so a moderator can read a member's history, which is the point
/// of recording them separately from Discord's own audit log.
model Infraction {
  id          Int       @id @default(autoincrement())
  guildId     String
  userId      String
  moderatorId String
  action      String
  reason      String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  active      Boolean   @default(true)
  /// Stored rather than derived from row order, so removing a row for good
  /// leaves a gap and never renumbers the cases after it.
  caseNumber  Int       @default(0)
  /// Set when staff remove an entry from a member's record. The row stays, so
  /// the removal is visible in the mod dashboard; only the owner can purge it.
  voidedAt    DateTime?
  voidedBy    String?
  voidReason  String?
  /// Set when someone changes the reason after the action was taken.
  editedAt    DateTime?
  editedBy    String?
  /// Messages a moderator attached, copied as they read when the action was taken, as JSON.
  evidence    String    @default("[]")
  /// Set on a case the bot took by itself because an escalation rule fired, as JSON
  /// `{ ruleId, rule, warns, windowMs, fromCase }`. Null for every other case.
  automatic   String?
  /// False for an automod warning whose rule is set not to count toward escalation.
  escalates   Boolean   @default(true)

  guild   Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  appeals Appeal[]

  @@unique([guildId, caseNumber])
  @@index([guildId, userId])
  @@index([guildId, createdAt])
}

/// Work the bot has to carry out later: lifting a temporary ban, closing an
/// idle ticket. This lives in the database, not a timer. A restart would lose
/// a timer, and a lost unban leaves someone banned with nothing to explain it.
model ScheduledTask {
  id      Int      @id @default(autoincrement())
  guildId String
  kind    String
  runAt   DateTime
  payload String   @default("{}")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([runAt])
}

/// A role menu the bot has posted. The message id is the only link between a
/// reaction Discord reports and the roles that menu hands out, so it has to
/// outlive the process that posted it.
model ReactionRoleMenu {
  id        Int    @id @default(autoincrement())
  guildId   String
  channelId String
  messageId String @unique
  mapping   String @default("[]")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

/// One ticket. `id` is the internal key, shared across every server on the
/// instance; `number` is what people see (`#42`), counted per server. The
/// type, panel and names are copied in when the ticket opens so it still reads
/// right after a type is removed or a member leaves.
model Ticket {
  id        Int       @id @default(autoincrement())
  guildId   String
  /// The number in this server, handed out when the ticket opens. Null only on a
  /// row made some other way, which then shows its id.
  number    Int?
  channelId String    @unique
  openerId  String
  subject   String?
  status    String    @default("open")
  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  closedBy  String?

  typeId           String?
  panelId          String?
  typeName         String    @default("")
  /// JSON `[{ label, value }]`, the answers to the type's form in order.
  answers          String    @default("[]")
  claimedById      String?
  claimedAt        DateTime?
  /// One of TICKET_PRIORITIES in packages/core/src/tickets.ts.
  priority         String    @default("normal")
  /// The first message from someone other than the opener and not a bot.
  firstResponseAt  DateTime?
  lastActivityAt   DateTime  @default(now())
  closeReason      String?
  closedByName     String?
  rating           Int?
  ratingComment    String?
  ratedAt          DateTime?
  /// `channel` or `thread`.
  mode             String    @default("channel")
  /// Closed but the channel was kept, locked, so it can be reopened.
  archived         Boolean   @default(false)
  channelName      String    @default("")
  openerName       String    @default("")
  messageCount     Int       @default(0)
  reopenedCount    Int       @default(0)
  closeRequestedAt DateTime?
  /// The first message in the ticket, whose Claim button the bot swaps for Unclaim.
  controlsMessageId String?
  /// Who sent the message that set `firstResponseAt`, for the per-handler stats.
  firstResponderId  String?
  /// Set when a manager deleted the stored messages, kept so the transcript can say who and when.
  transcriptDeletedAt     DateTime?
  transcriptDeletedById   String?
  transcriptDeletedByName String?
  /// Set when the retention period removed the stored messages.
  messagesPrunedAt  DateTime?
  /// The opener left the server while the ticket was open.
  openerLeftAt      DateTime?

  guild    Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  messages TicketMessage[]
  notes    TicketNote[]
  events   TicketEvent[]

  @@unique([guildId, number])
  @@index([guildId, status])
  @@index([guildId, openedAt])
  @@index([guildId, typeId, status])
  @@index([guildId, claimedById])
}

/// A message in a ticket, stored as it happens so the transcript outlives the
/// channel. Attachment files stay on Discord; only their links are kept.
model TicketMessage {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  messageId     String
  authorId      String
  authorName    String
  authorAvatar  String?
  authorIsStaff Boolean   @default(false)
  /// The author's top role colour as `#rrggbb`, null when no role colours them.
  authorColor   String?
  /// A bot or a webhook, which Discord tags APP.
  authorBot     Boolean   @default(false)
  /// Discord id of the message this one replies to.
  replyToId     String?
  content       String    @default("")
  /// JSON `[{ name, url, contentType, size }]`.
  attachments   String    @default("[]")
  /// JSON, full embeds as `TicketEmbedDto`. Rows from before 2026-10-20 hold only `{ title, description }`.
  embeds        String    @default("[]")
  /// JSON `[{ components: [button or select] }]`, rows of buttons and menus as drawn.
  components    String    @default("[]")
  /// JSON `[{ id, name, format }]`.
  stickers      String    @default("[]")
  /// JSON `[{ emoji: { id, name, animated }, count }]`, read when the ticket closes.
  reactions     String    @default("[]")
  /// JSON `{ users, roles, channels }`, each mapping an id to `{ name, color }` as it was when stored.
  mentions      String    @default("{}")
  /// JSON `{ name, avatarUrl, staffLine }`, set on a dashboard reply sent under the support team's name. The author columns keep the real sender.
  sentAs        String?
  createdAt     DateTime  @default(now())
  editedAt      DateTime?
  deletedAt     DateTime?
  edits         Int       @default(0)
  /// `discord`, or `dashboard` for a reply sent from the workspace.
  source        String    @default("discord")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, messageId])
  @@index([ticketId, createdAt])
}

/// Staff-only notes on a ticket. Never sent to Discord.
model TicketNote {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// Something that happened to a ticket, for its timeline. `kind` is one of
/// TICKET_EVENT_KINDS in packages/core/src/tickets.ts and `detail` is JSON.
model TicketEvent {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  kind      String
  actorId   String?
  actorName String?
  detail    String   @default("{}")
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// Where a panel was last posted, so it can be edited in place. A row with an
/// empty `messageId` records a panel the version before panels were tracked
/// posted somewhere unknown.
model TicketPanelPost {
  id        Int      @id @default(autoincrement())
  guildId   String
  panelId   String
  channelId String
  messageId String
  postedAt  DateTime @default(now())
  /// A fingerprint of what was posted, to tell when the settings changed since.
  hash      String   @default("")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, panelId])
}

/// A member may not open another ticket of this type before `until`.
model TicketCooldown {
  guildId String
  userId  String
  typeId  String
  until   DateTime

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, typeId])
}

/// Manager actions on tickets that leave nothing else behind, such as a
/// deleted transcript. `detail` is JSON.
model TicketAudit {
  id        Int      @id @default(autoincrement())
  guildId   String
  actorId   String
  actorName String
  kind      String
  ticketId  Int?
  detail    String   @default("{}")
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
}

/// Per-member experience. This is the only table written on a hot path, one
/// upsert per message that earns experience, so it stays narrow and is keyed
/// for exactly that write.
model LevelMember {
  guildId     String
  userId      String
  xp          Int      @default(0)
  level       Int      @default(0)
  lastAwardAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([guildId, xp])
}

/// Where the feeds module has got to with one source. Without the remembered
/// ids, every restart would post the whole feed again. The key is `rss:<url>`
/// or `steam:<appid>:<channel>`: a game shown in two channels is tracked
/// separately in each.
model FeedCursor {
  guildId   String
  sourceKey String
  seen      String    @default("[]")
  checkedAt DateTime?
  lastError String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, sourceKey])
}

/// A staff note about a member. Deleting one only hides it; the owner can
/// purge it for good, which removes its history along with it.
model ModNote {
  id        Int       @id @default(autoincrement())
  guildId   String
  userId    String
  authorId  String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
}

/// Everything staff do in the mod dashboard. `before` and `after` hold JSON
/// snapshots so an edit or a removal can be read back in full.
model ModAudit {
  id           Int      @id @default(autoincrement())
  guildId      String
  at           DateTime @default(now())
  actorId      String
  actorName    String
  actorRole    String
  kind         String
  targetUserId String?
  infractionId Int?
  noteId       Int?
  summary      String
  before       String?
  after        String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, at])
  @@index([guildId, targetUserId])
  @@index([infractionId])
  @@index([noteId])
}

/// A banned member asking for the ban on one case to be lifted, sent from the
/// button on the ban's direct message. Banned members are not in the server, so
/// this cannot be a ticket. `status` is pending, accepted or denied.
model Appeal {
  id            Int       @id @default(autoincrement())
  guildId       String
  userId        String
  infractionId  Int
  caseNumber    Int
  text          String
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?
  decidedBy     String?
  decidedByName String?
  /// What the member was told with the decision.
  response      String?

  guild      Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  infraction Infraction @relation(fields: [infractionId], references: [id], onDelete: Cascade)

  @@index([guildId, status, createdAt])
  @@index([guildId, userId])
  @@index([infractionId])
}

/// A channel the bot locked during a lockdown, with what the @everyone
/// overwrite said about each permission it changed, so unlocking puts back
/// exactly that and leaves every other permission alone. Kept in the database
/// so a restart in the middle of a lockdown does not lose the way back.
model LockedChannel {
  guildId   String
  channelId String
  /// JSON `{ had: boolean, bits: { [name]: "allow" | "deny" | "unset" } }`.
  previous  String
  lockedAt  DateTime  @default(now())
  lockedBy  String
  reason    String?
  /// When the lockdown lifts by itself, if it was given a length.
  endsAt    DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, channelId])
}

/// Who may open the mod dashboard for a server, and at what level. The
/// instance owner is implied everywhere and never listed here.
model StaffMember {
  guildId String
  userId  String
  role    String
  addedBy String
  addedAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
}

/// A folder for message templates. One level deep: a folder holds templates,
/// never other folders, which is enough to keep a long list tidy.
model MessageFolder {
  id        Int      @id @default(autoincrement())
  guildId   String
  name      String
  createdAt DateTime @default(now())

  guild     Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  templates MessageTemplate[]

  @@index([guildId])
}

/// A message an owner built in the dashboard, kept so it can be sent again.
/// `embeds` is a JSON array in the shape packages/core/src/message.ts
/// validates, so a template that was valid when saved stays valid to send.
model MessageTemplate {
  id         Int       @id @default(autoincrement())
  guildId    String
  /// Null for a template that sits outside every folder. Deleting a folder
  /// leaves its templates here rather than taking them along.
  folderId   Int?
  name       String
  content    String    @default("")
  embeds     String    @default("[]")
  /// Link buttons, as JSON. Reactions are a JSON list of emoji.
  buttons    String    @default("[]")
  /// Select menus, as JSON.
  selects    String    @default("[]")
  reactions  String    @default("[]")
  /// Staff can pick this message from the ticket reply box.
  inTickets  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSentAt DateTime?

  guild  Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  folder MessageFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([guildId, folderId])
}

/// Where a message from the Message creator went, so a template can list its sends
/// and a sent message can be edited later. `templateId` is null for a message that
/// was not sent from a template, and is kept as a plain number so deleting a
/// template leaves its history readable.
model MessageSend {
  id         Int      @id @default(autoincrement())
  guildId    String
  templateId Int?
  channelId  String
  messageId  String
  /// Sent through a webhook with a chosen name, so it can only be edited the same way.
  viaWebhook Boolean  @default(false)
  sentAt     DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, messageId])
  @@index([guildId, templateId, sentAt])
}

/// What the buttons and menus of a message that was sent do. Kept per message, so
/// editing a template afterwards never changes one that is already out.
model MessageInteraction {
  messageId String   @id
  guildId   String
  channelId String
  /// Buttons and menus as sent, with their actions, as JSON.
  buttons   String   @default("[]")
  selects   String   @default("[]")
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

/// A message the bot saw, kept so staff can search what was said, including what
/// was deleted or edited. Only written while a server has the message log on, and
/// pruned to the number of days that server chose. `content` is the current text;
/// earlier text is in LoggedMessageEdit.
model LoggedMessage {
  id            Int       @id @default(autoincrement())
  guildId       String
  messageId     String
  channelId     String
  /// The channel's name when the message was sent, so the log still reads if it is renamed or deleted.
  channelName   String    @default("")
  authorId      String
  authorName    String    @default("")
  content       String    @default("")
  /// Names and links of attached files as JSON. The files themselves stay on Discord.
  attachments   String    @default("[]")
  createdAt     DateTime
  editedAt      DateTime?
  deletedAt     DateTime?
  /// "author", "moderator", "automod" or "bot". Null when nobody could say, or before this was recorded.
  deletedBy     String?
  deletedById   String?
  /// The deleter's name when they deleted it, because a moderator may have left or renamed since.
  deletedByName String?
  /// What it carried besides text and files, such as "1 sticker", so a message without text can say what it was.
  extras        String    @default("")

  guild Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  edits LoggedMessageEdit[]

  @@unique([guildId, messageId])
  @@index([guildId, createdAt])
  @@index([guildId, authorId, createdAt])
  @@index([guildId, channelId, createdAt])
}

/// A version of a message's text that an edit replaced, and when that text went up.
model LoggedMessageEdit {
  id       Int      @id @default(autoincrement())
  loggedId Int
  content  String
  at       DateTime

  message LoggedMessage @relation(fields: [loggedId], references: [id], onDelete: Cascade)

  @@index([loggedId])
}

/// One thing that happened on the server, kept so staff can search it. Written only for the
/// kinds of event a server has switched on, and pruned to the number of days it chose. The
/// ids and names are copied in, so an entry still reads right after a member or channel is gone.
model ServerLogEntry {
  id          Int      @id @default(autoincrement())
  guildId     String
  at          DateTime @default(now())
  /// One of the categories in packages/core/src/serverlog.ts.
  category    String
  /// One of the types in packages/core/src/serverlog.ts.
  type        String
  actorId     String?
  actorName   String   @default("")
  targetId    String?
  targetName  String   @default("")
  channelId   String?
  channelName String   @default("")
  summary     String
  /// Changes, notes and the message it is about, as JSON.
  details     String   @default("{}")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, at])
  @@index([guildId, category, at])
  @@index([guildId, type, at])
  @@index([guildId, actorId, at])
  @@index([guildId, targetId, at])
  @@index([guildId, channelId, at])
}

/// A voice channel the bot made for a member, kept so it is still cleaned up after a restart.
model VoiceRoom {
  id        Int      @id @default(autoincrement())
  guildId   String
  channelId String   @unique
  /// The generated id of the hub row in the settings that made it, or "lfg" for a party's room.
  hubId     String
  ownerId   String
  /// The lowest number not used by another room of the same hub, for the {number} in a name.
  number    Int      @default(0)
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, hubId])
  @@index([guildId, ownerId])
}

/// Where a group panel was posted, so it can be edited in place when its settings change.
model GroupPanelPost {
  id        Int      @id @default(autoincrement())
  guildId   String
  /// The generated id of the panel row in the settings.
  panelId   String
  channelId String
  messageId String   @unique
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, panelId])
}

/// A group a member started from a panel: a voice channel, and once its owner is in it, a private thread with the
/// controls. The row is deleted when the group ends, and the thread is kept archived.
model PlayGroup {
  id                Int       @id @default(autoincrement())
  guildId           String
  panelId           String
  optionId          String
  ownerId           String
  voiceChannelId    String    @unique
  threadId          String?
  controlsMessageId String?
  /// The post in the panel channel that tells others the group has room, when its option announces.
  announcementMessageId String?
  /// What the group is playing, as the owner typed it or the option set it. Empty when neither.
  game              String    @default("")
  /// "waiting" until the owner is in the voice channel, then "active".
  status            String    @default("waiting")
  isPrivate         Boolean   @default(false)
  /// The number the voice channel's name was made with.
  number            Int       @default(0)
  /// How long the owner has to join before the voice channel is removed.
  joinBy            DateTime
  createdAt         DateTime  @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([guildId, ownerId])
}

/// A looking-for-group post. The author counts as the first player, so a post that needs
/// three more has four places in all.
model LfgPost {
  id             Int       @id @default(autoincrement())
  guildId        String
  channelId      String
  messageId      String?
  /// The generated id of the game row in the settings. The name is copied in so a removed game still reads right.
  gameId         String
  gameName       String
  authorId       String
  authorName     String
  needed         Int
  note           String    @default("")
  startsAt       DateTime?
  /// "open", "full", "closed" or "expired".
  status         String    @default("open")
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  closedAt       DateTime?
  /// The voice channel made for the party when the post filled, if the server asks for one.
  voiceChannelId String?

  guild   Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  members LfgMember[]

  @@index([guildId, status])
  @@index([guildId, authorId, status])
  @@index([guildId, authorId, createdAt])
  @@index([status, expiresAt])
}

/// Someone who joined a looking-for-group post, other than its author.
model LfgMember {
  id       Int      @id @default(autoincrement())
  postId   Int
  userId   String
  userName String
  joinedAt DateTime @default(now())

  post LfgPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

/// A scrim or tournament sign-up. A capacity of 0 means no limit.
model SignupEvent {
  id            Int       @id @default(autoincrement())
  guildId       String
  channelId     String
  messageId     String?
  title         String
  game          String    @default("")
  note          String    @default("")
  startsAt      DateTime?
  /// Players to a team. 1 means players sign up alone.
  teamSize      Int       @default(1)
  /// The most teams, or players when the team size is 1, that can be registered.
  capacity      Int       @default(0)
  waitlist      Boolean   @default(true)
  /// Role ids as JSON. A member needs one of them to sign up, or none are needed when the list is empty.
  requiredRoles String    @default("[]")
  rewardRoleId  String?
  /// "open" or "closed".
  status        String    @default("open")
  reminderSent  Boolean   @default(false)
  createdById   String
  createdAt     DateTime  @default(now())
  closedAt      DateTime?

  guild   Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  entries SignupEntry[]
  members SignupMember[]

  @@index([guildId, status])
  @@index([guildId, createdAt])
}

/// One player or team on a sign-up, either registered or waiting for a place.
model SignupEntry {
  id        Int      @id @default(autoincrement())
  eventId   Int
  captainId String
  teamName  String   @default("")
  /// "registered" or "waitlist".
  status    String
  createdAt DateTime @default(now())

  event   SignupEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members SignupMember[]

  @@index([eventId, status, id])
}

/// A person on a sign-up entry, the captain included. One row per person per event keeps anyone from signing up twice.
model SignupMember {
  id      Int    @id @default(autoincrement())
  entryId Int
  eventId Int
  userId  String

  entry SignupEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  event SignupEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([entryId])
}

/// A number a workflow keeps, such as a count or a flag, for one member or for the whole server.
model WorkflowValue {
  id        Int      @id @default(autoincrement())
  guildId   String
  /// "member" or "server".
  scope     String
  /// The member's id for the member scope, empty for the server.
  subjectId String   @default("")
  name      String
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, scope, subjectId, name])
}
