generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guild {
  id       String   @id
  name     String
  joinedAt DateTime @default(now())

  modules  GuildModule[]
  overrides CommandOverride[]
}

/// Per-guild module state. Settings are stored as JSON and validated against
/// the module's schema on read, so adding a setting needs no migration.
model GuildModule {
  guildId   String
  moduleId  String
  enabled   Boolean  @default(false)
  settings  String   @default("{}")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, moduleId])
}

/// Only written when an operator overrides the default, which is that every
/// command of an enabled module is visible.
model CommandOverride {
  guildId      String
  command      String
  enabled      Boolean @default(true)
  allowRoles   String  @default("[]")
  denyChannels String  @default("[]")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, command])
}

model Instance {
  id           Int      @id @default(1)
  ownerId      String?
  setupAt      DateTime?
  schemaVersion Int     @default(1)
}

/// Auth.js's own tables, laid out the way @auth/prisma-adapter expects them.
/// This supersedes the previous hand-rolled Session model: Auth.js owns the
/// session lifecycle (creation, rotation, expiry sweeps) and the Account rows
/// are also where each user's Discord OAuth tokens live, which the dashboard
/// needs to call the Discord API on their behalf.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
