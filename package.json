{
  "name": "tier0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "db:migrate": "pnpm --filter @tier0/db migrate",
    "db:studio": "pnpm --filter @tier0/db studio"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}
