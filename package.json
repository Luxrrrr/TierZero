{
  "name": "tier0",
  "private": true,
  "version": "0.3.3",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "test": "tsc -b && node --test \"packages/*/test/*.test.ts\" \"packages/modules/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "typecheck": "tsc -b && pnpm --filter @tier0/web typecheck",
    "db:migrate": "pnpm --filter @tier0/db migrate",
    "db:studio": "pnpm --filter @tier0/db studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0"
  }
}
