# Copy to .env before starting. The setup wizard writes these for you if you
# would rather not create the application by hand.

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Generate with: openssl rand -hex 32
AUTH_SECRET=
INTERNAL_API_SECRET=

DATABASE_URL=file:../../data/tier0.db
DASHBOARD_URL=http://localhost:8080

# The bot's control API. Under Compose the two containers reach each other over
# the internal network, which is why the bot binds every interface here: the
# port is never published, so nothing outside the compose network can reach it.
# Running both from source on one machine, leave CONTROL_HOST unset and it binds
# loopback only, and point CONTROL_API_URL at http://127.0.0.1:8081.
CONTROL_PORT=8081
CONTROL_HOST=0.0.0.0
CONTROL_API_URL=http://bot:8081

# Optional. A Discord user ID here fixes the instance owner. Left blank, the
# first account through the setup wizard claims it.
INSTANCE_OWNER_ID=
