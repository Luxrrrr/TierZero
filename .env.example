# Copy this to .env and fill it in before you start. The three DISCORD values
# come from your application in the Discord Developer Portal.

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Generate with: openssl rand -hex 32
AUTH_SECRET=
INTERNAL_API_SECRET=

# Relative SQLite paths are resolved from the schema file, which lives in
# packages/db/prisma, so this points at data/ in the repository root.
DATABASE_URL=file:../../../data/tier0.db

# The bot's control API. Under Compose, docker-compose.yml already binds it to
# the internal network and never publishes the port, so nothing here needs
# changing. Running both from source on one machine, leave CONTROL_HOST unset so
# it binds loopback only, and set CONTROL_API_URL to http://127.0.0.1:8081.
CONTROL_PORT=8081
# CONTROL_HOST=0.0.0.0
CONTROL_API_URL=http://bot:8081

# Optional. By default the dashboard answers on every address the machine has, so
# devices on your home network or Tailscale can open it. On a server that is
# reachable from the internet, set this to 127.0.0.1 and put a Cloudflare Tunnel
# or a reverse proxy in front for HTTPS. Docker publishes ports around most
# firewalls, so do not rely on one to keep it private.
# DASHBOARD_BIND=127.0.0.1

# The dashboard refuses to sign anyone in over plain HTTP at an address the
# internet can reach. This turns that off, for an address you know is private.
# ALLOW_INSECURE_HTTP=true

# Optional. The owner of the install is whoever owns the Discord application,
# which the bot reads when it connects. A Discord user ID here overrides that,
# for handing the install to someone else or naming the owner of a team application.
INSTANCE_OWNER_ID=
